        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"production-review\",uri!=\"/api/v1/notification/sse\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "range": true,
          "instant": false
