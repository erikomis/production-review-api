# Copie para .env e preencha. Usado pela API (env_file) e pelo docker-compose (Grafana).

# ---------- Banco e cache ----------
DATABASE_URL=jdbc:mariadb://db:3306/production
DATABASE_USERNAME=
DATABASE_PASSWORD=
REDIS=redis

# ---------- Segurança ----------
SECRET=
ALLOWED_ORIGINS=https://seudominio.com,https://admin.seudominio.com
FRONTEND_URL=https://admin.seudominio.com

# ---------- E-mail (cadastro, recuperação de senha e alertas do Grafana) ----------
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- Imagens (MinIO) ----------
URL=https://storage.seudominio.com
ACESS_NAME=
ACESS_SECRET=
BUCKET_NAME=production-review

# ---------- Auditoria (Kafka + serviço de logs) ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
LOGS_SERVICE_URL=http://logs:8089
LOGS_API_TOKEN=

# ---------- Observabilidade (Grafana) ----------
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_ADMIN_USER=admin
# ALERT_EMAIL=equipe@seudominio.com
# GRAFANA_ROOT_URL=https://grafana.seudominio.com
# PROMETHEUS_RETENTION=15d
